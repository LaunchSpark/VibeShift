# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Local PocketBase superuser (created automatically by `pixi run pb`)
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=12345678

# Optional
POCKETBASE_URL=http://127.0.0.1:8090
VIBESHIFT_TZ=UTC
SCORE_CHUNK=8
JOB_POLL_SECONDS=5
